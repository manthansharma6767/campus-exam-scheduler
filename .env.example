# Local application database (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/campus_exam_scheduler?serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_mysql_username
SPRING_DATASOURCE_PASSWORD=replace_with_your_local_mysql_password

# Replace these placeholders with unique random values; never commit real values.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
ADMIN_SETUP_TOKEN=replace_with_a_random_one_time_setup_token

CORS_ALLOWED_ORIGINS=http://localhost:5173
SPRING_JPA_SHOW_SQL=false

# Separate MySQL database used by backend integration tests. Tests use create-drop.
TEST_DATASOURCE_URL=jdbc:mysql://localhost:3306/campus_exam_scheduler_test?serverTimezone=UTC
TEST_DATASOURCE_USERNAME=your_mysql_username
TEST_DATASOURCE_PASSWORD=replace_with_your_local_mysql_password

# Vite reads this variable when the frontend is started.
VITE_API_BASE_URL=http://localhost:8080
