# Local development
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/campus_exam_scheduler?serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_mysql_username
SPRING_DATASOURCE_PASSWORD=replace_with_your_local_mysql_password

# Replace these placeholders with unique random values; never commit real values.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
ADMIN_SETUP_TOKEN=replace_with_a_random_one_time_setup_token

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080
SPRING_JPA_SHOW_SQL=false

# Backend tests use the same existing campus_exam_scheduler schema.
# They never create or drop tables and roll back every test's records.
TEST_DATASOURCE_URL=jdbc:mysql://localhost:3306/campus_exam_scheduler?serverTimezone=UTC
TEST_DATASOURCE_USERNAME=your_mysql_username
TEST_DATASOURCE_PASSWORD=replace_with_your_local_mysql_password

# Vite reads this variable when the frontend is started.
VITE_API_BASE_URL=http://localhost:8080

# Docker Compose. Copy this file to .env in the repository root and replace
# every placeholder before running "docker compose up".
MYSQL_DATABASE=campus_exam_scheduler
MYSQL_USER=campus_app
MYSQL_PASSWORD=replace_with_a_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password
FRONTEND_PORT=8080
BACKEND_PORT=8081
SWAGGER_ENABLED=false
